# Kora RPC Node Environment Variables
# Copy this file to .env and fill in your values

# ====================
# Required Configuration
# ====================

# Solana RPC endpoint (choose one based on your network)
# Local: http://127.0.0.1:8899
# Devnet: https://api.devnet.solana.com
# Mainnet: Use a reliable RPC provider
RPC_URL=https://api.devnet.solana.com

# Fee payer private key (the keypair that pays transaction fees)
# Supported formats:
# 1. JSON array: [123,45,67,89,...]
# 2. Base58 string: 5JK...
# 3. Path to JSON file: /path/to/keypair.json
KORA_PRIVATE_KEY=[123,45,67,89,12,34,56,78,90,12,34,56,78,90,12,34,56,78,90,12,34,56,78,90,12,34,56,78,90,12,34,56,78,90,12,34,56,78,90,12,34,56,78,90,12,34,56,78,90,12,34,56,78,90,12,34,56]

# ====================
# Server Configuration
# ====================

# Port to run the RPC server on
PORT=8080

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info

# ====================
# Optional: Authentication
# ====================

# API key for simple header-based authentication
# Leave empty to disable API key auth
API_KEY=

# HMAC secret for signature-based authentication
# Leave empty to disable HMAC auth
HMAC_SECRET=

# ====================
# Optional: Redis Cache
# ====================

# Redis URL for caching (improves performance)
# Uncomment and set to enable Redis caching
# REDIS_URL=redis://redis:6379

# ====================
# Optional: Monitoring
# ====================

# Grafana admin credentials (only if using monitoring profile)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ====================
# Optional: Vault Signer
# ====================

# HashiCorp Vault configuration (if using Vault signer)
# VAULT_URL=https://vault.example.com
# VAULT_TOKEN=your-vault-token
# VAULT_PATH=secret/data/kora/signer

# ====================
# Optional: Turnkey Signer
# ====================

# Turnkey API configuration (if using Turnkey signer)
# TURNKEY_ORGANIZATION_ID=your-org-id
# TURNKEY_API_PUBLIC_KEY=your-api-public-key
# TURNKEY_API_PRIVATE_KEY=your-api-private-key
# TURNKEY_PRIVATE_KEY_ID=your-private-key-id

# ====================
# Optional: Privy Signer
# ====================

# Privy API configuration (if using Privy signer)
# PRIVY_APP_ID=your-app-id
# PRIVY_APP_SECRET=your-app-secret
# PRIVY_WALLET_ID=your-wallet-id
