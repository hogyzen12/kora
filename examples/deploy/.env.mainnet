# Kora RPC Node - MAINNET Configuration
# App: unruggable

# ====================
# Required Configuration
# ====================

# Solana RPC endpoint - USE A RELIABLE RPC PROVIDER
# Options:
# - Helius: https://mainnet.helius-rpc.com/?api-key=YOUR-KEY
# - QuickNode: https://YOUR-ENDPOINT.quiknode.pro/YOUR-TOKEN/
# - Triton: https://YOUR-PROJECT.rpc.extrnode.com/YOUR-TOKEN
# - Alchemy: https://solana-mainnet.g.alchemy.com/v2/YOUR-API-KEY
RPC_URL=https://api.mainnet-beta.solana.com

# Fee payer private key (from unruggable-feepayer.json)
KORA_PRIVATE_KEY=PLACEHOLDER_WILL_BE_REPLACED

# ====================
# Server Configuration
# ====================

PORT=8080
RUST_LOG=info

# ====================
# Authentication (REQUIRED for mainnet)
# ====================

# API Key - Generate a strong random key
# Generate with: openssl rand -base64 32
API_KEY=CHANGE_THIS_TO_SECURE_API_KEY

# HMAC Secret - Generate a strong random secret
# Generate with: openssl rand -base64 64
HMAC_SECRET=CHANGE_THIS_TO_SECURE_HMAC_SECRET

# ====================
# Optional: Redis for Production
# ====================

# Uncomment and set if using Redis for caching
# REDIS_URL=redis://your-redis-url:6379
